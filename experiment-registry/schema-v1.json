{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kaiozen-reshade-experiment-registry/v1",
  "title": "Kaiozen ReShade experiment registry entry",
  "type": "object",
  "required": ["schema", "repository", "version", "parent", "source_commit", "status", "purpose", "safety", "artifact"],
  "properties": {
    "schema": {"const": "kaiozen-reshade-experiment-registry/v1"},
    "repository": {"type": "string"},
    "branch": {"type": "string"},
    "version": {"type": "string"},
    "parent": {"type": "string"},
    "source_commit": {"type": "string"},
    "build_timestamp": {"type": "string"},
    "status": {"enum": ["BUILT_NOT_RUN", "RUN_PASS", "RUN_INVALID", "RUN_FAIL", "RETIRED_NO_RERUN"]},
    "purpose": {"type": "string"},
    "safety": {"type": "object"},
    "artifact": {
      "type": "object",
      "required": ["filename", "sha256"],
      "properties": {
        "filename": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "runtime": {"type": "object"},
    "report": {"type": "object"},
    "result_markers": {"type": "array", "items": {"type": "string"}},
    "no_rerun": {"type": "boolean"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
